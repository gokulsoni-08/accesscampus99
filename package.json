{
  "name": "accesscampus",
  "version": "2.0.0",
  "private": true,
  "description": "IIMA AccessCampus with Google sign-in, secure sessions and Admin / User roles",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "node --env-file-if-exists=.env --watch server/index.js",
    "test": "node --test tests/auth.test.js tests/reports.test.js"
  },
  "dependencies": {
    "@libsql/client": "^0.15.15",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "jose": "^5.10.0"
  }
}
